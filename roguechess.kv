# -----------------------------------------
# เทมเพลตกลางสำหรับฉากหลัก (5 เลเยอร์)
# -----------------------------------------
<ParallaxScreen>:
    FloatLayout:
        Image:
            id: layer_1
            source: root.layer_1_src
            fit_mode: 'fill'
            size_hint: 1.03, 1.03
            pos_hint: {'center_x': 0.5, 'y': 0}
        Image:
            id: layer_2
            source: root.layer_2_src
            fit_mode: 'fill'
            size_hint: 1.08, 1.08
            pos_hint: {'center_x': 0.5, 'y': 0}
        Image:
            id: layer_3
            source: root.layer_3_src
            fit_mode: 'fill'
            size_hint: 1.12, 1.12
            pos_hint: {'center_x': 0.5, 'y': 0}
        Image:
            id: layer_4
            source: root.layer_4_src
            fit_mode: 'fill'
            size_hint: 1.18, 1.18
            pos_hint: {'center_x': 0.5, 'y': 0}
        Image:
            id: layer_5
            source: root.layer_5_src
            fit_mode: 'fill'
            size_hint: 1.26, 1.26
            pos_hint: {'center_x': 0.5, 'y': 0}

